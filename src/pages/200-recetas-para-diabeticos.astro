---
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

const CHECKOUT_URL = 'https://pay.hotmart.com/L101237086P?checkoutMode=10&bid=1790254008276';

// Botón "Pincha aquí" del banner: abre WhatsApp con un mensaje ya escrito.
// Número en formato internacional, sin "+" ni espacios (+34 744 66 57 61).
const WHATSAPP_NUMBER = '34744665761';
const WHATSAPP_MESSAGE = 'Hola, acabo de pedir el recurso gratuito de los 7 desayunos y tengo una consulta.';
const CONTACT_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;

// Precios en €. OLD_PRICE y BONUS_VALUES deben ser valores reales de referencia.
const fmt = (n: number) => n.toFixed(2).replace('.', ',');
const PRICE_N = 17.68;
const OLD_PRICE_N = 24.99;
const BONUS_VALUES = [12, 10, 8, 9, 7];
const TOTAL_VALUE_N = OLD_PRICE_N + BONUS_VALUES.reduce((a, b) => a + b, 0);

const PRICE = fmt(PRICE_N);
const OLD_PRICE = fmt(OLD_PRICE_N);
const TOTAL_VALUE = fmt(TOTAL_VALUE_N);
const SAVINGS = fmt(TOTAL_VALUE_N - PRICE_N);

// SEO: keyword principal "recetas para diabéticos" (+ "200 recetas para diabéticos").
const title = '200 Recetas para Diabéticos + 5 Bonos | Recetario Digital';
const description =
  'Recetario digital con 200+ recetas para diabéticos: desayunos, almuerzos, cenas y postres fáciles. Incluye 5 bonos y garantía de 7 días.';
const PAGE_PATH = '/200-recetas-para-diabeticos';
const site = Astro.site;
const canonical = site ? new URL(PAGE_PATH, site).href : undefined;
const abs = (path: string) => (site ? new URL(path, site).href : path);
const ogImage = abs('/ventas/og-200-recetas-para-diabeticos.jpg');

const icons = {
  book: 'M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2V5Zm0 16a2 2 0 0 1 2-2h13',
  gift: 'M3 8h18v4H3V8Zm2 4h14v9H5v-9Zm7-4v13M12 8c-2 0-4-1-4-3s3-2 4 3Zm0 0c2 0 4-1 4-3s-3-2-4 3Z',
  device: 'M7 3h10a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm4 15h2',
  shield: 'M12 3 4 6v6c0 4.5 3.2 8 8 9 4.8-1 8-4.5 8-9V6l-8-3Zm-3 9 2 2 4-4',
  bolt: 'M13 2 4 14h7l-1 8 9-12h-7l1-8Z',
  lock: 'M6 11h12v9H6v-9Zm2 0V8a4 4 0 0 1 8 0v3',
  check: 'm5 12 5 5 9-10',
  question: 'M9 9a3 3 0 1 1 4.2 2.7c-.8.4-1.2 1-1.2 1.8M12 17.5v.5',
  repeat: 'M17 2l4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4M21 13v2a3 3 0 0 1-3 3H3',
  layers: 'm12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5',
  sun: 'M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0-13v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4',
  plate: 'M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm0-4a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
  moon: 'M20 14.5A8 8 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z',
  apple: 'M12 7c-2-2-6-1-6 4 0 4 2 9 4 9 1 0 1.5-.5 2-.5s1 .5 2 .5c2 0 4-5 4-9 0-5-4-6-6-4Zm0 0c0-2 1-3 3-4',
  cake: 'M4 20h16v-6H4v6Zm0-6c0-2 2-3 4-3h8c2 0 4 1 4 3M12 11V6m0-3v1',
};

const problems = [
  {
    icon: 'question',
    title: '¿Y hoy qué cocino?',
    text: 'Con diabetes, elegir cada comida agota. Tener las ideas listas te ahorra esa duda todos los días.',
  },
  {
    icon: 'repeat',
    title: 'Siempre lo mismo',
    text: 'Cuando repites los mismos platos, comer se vuelve aburrido. Aquí tienes variedad de sobra.',
  },
  {
    icon: 'layers',
    title: 'Todo en un solo lugar',
    text: 'Deja de buscar recetas sueltas por internet. Todo el material ordenado, en tu móvil o tablet.',
  },
];

const categories = [
  { icon: 'sun', name: 'Desayunos' },
  { icon: 'plate', name: 'Almuerzos' },
  { icon: 'moon', name: 'Cenas' },
  { icon: 'apple', name: 'Snacks' },
  { icon: 'cake', name: 'Postres' },
];

const bonuses = [
  {
    n: 1,
    name: 'Plan de jugoterapia',
    text: 'Jugos y batidos naturales para acompañar tu día a día.',
  },
  {
    n: 2,
    name: 'Panes sin gluten',
    text: 'Recetas de panes caseros, sin gluten y fáciles de preparar.',
  },
  {
    n: 3,
    name: 'Guía de alimentación inteligente',
    text: 'Una guía clara para elegir mejor qué poner en tu plato.',
  },
  {
    n: 4,
    name: 'Pierde peso en 15 días',
    text: 'Un recetario con propuestas ligeras para 15 días.',
  },
  {
    n: 5,
    name: '30 comidas saludables',
    text: '30 recetas extra para no quedarte nunca sin ideas.',
  },
];

const steps = [
  { title: 'Pulsa el botón', text: 'Te llevamos al checkout seguro de Hotmart.' },
  { title: 'Completa tu pago', text: 'Pago único con los métodos disponibles en Hotmart.' },
  { title: 'Recibe el acceso', text: 'Te llega por correo. Ábrelo desde móvil, tablet u ordenador.' },
];

const testimonials = [
  { src: 1, w: 720, h: 975, alt: 'Mensaje de una clienta agradeciendo el recetario y contando que ahora se siente más tranquila al preparar sus comidas' },
  { src: 2, w: 480, h: 867, alt: 'Conversación de WhatsApp sobre una ensalada del recetario y mejor descanso' },
  { src: 3, w: 480, h: 1007, alt: 'Conversación de WhatsApp de un cliente que recomienda el recetario' },
];

const included = [
  { label: 'Recetario con 200+ recetas', value: OLD_PRICE },
  ...bonuses.map((b) => ({ label: `Bono ${b.n} · ${b.name}`, value: fmt(BONUS_VALUES[b.n - 1]) })),
];

const faqs = [
  {
    q: '¿Cómo recibo el recetario?',
    a: 'Cuando se confirma el pago, recibes las instrucciones de acceso en el correo que usaste en la compra.',
  },
  {
    q: '¿Es un producto físico?',
    a: 'No. Es 100% digital: lo consultas desde el móvil, la tablet o el ordenador.',
  },
  {
    q: '¿Qué incluye exactamente?',
    a: 'El recetario principal con más de 200 recetas y los 5 bonos digitales que ves en esta página.',
  },
  {
    q: '¿Para quién es este recetario para diabéticos?',
    a: 'Para personas con diabetes y para quienes cocinan para ellas y buscan ideas variadas de desayunos, almuerzos, cenas, snacks y postres. Es un material culinario y educativo.',
  },
  {
    q: '¿Qué tipos de recetas para diabéticos incluye?',
    a: 'Más de 200 recetas organizadas por momento del día: desayunos, almuerzos, cenas, snacks y postres, con ingredientes fáciles de encontrar. Además, 5 bonos con jugos, panes sin gluten, una guía de alimentación y 30 comidas saludables.',
  },
  {
    q: '¿Los bonos se pagan aparte?',
    a: 'No. Los 5 bonos vienen incluidos en la misma compra del pack, sin ningún costo adicional.',
  },
  {
    q: '¿Cómo funciona la garantía?',
    a: 'Tienes 7 días de garantía según las condiciones de Hotmart. Si no es lo que esperabas, pides el reembolso desde la propia plataforma.',
  },
  {
    q: '¿Sustituye a mi médico o nutricionista?',
    a: 'No. El material es educativo y culinario. No reemplaza un diagnóstico, un tratamiento ni recomendaciones médicas o nutricionales personalizadas.',
  },
  {
    q: '¿Quién procesa el pago?',
    a: 'Hotmart, una plataforma de pagos segura. La compra y la entrega del acceso se gestionan ahí.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: '200 Recetas para Diabéticos + 5 Bonos',
    description,
    image: ogImage,
    brand: { '@type': 'Brand', name: 'Vividia' },
    category: 'Recetario digital',
    ...(canonical && { url: canonical }),
    offers: {
      '@type': 'Offer',
      price: PRICE_N.toFixed(2),
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
      url: CHECKOUT_URL,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#1f3324" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Vividia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Pack de 200 recetas para diabéticos con 5 bonos de regalo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <Analytics />
  </head>
  <body class="overflow-x-hidden pb-20 md:pb-0" data-price={PRICE_N}>
    <!-- BANNER DE CONFIRMACIÓN: solo aparece al llegar desde el formulario (?enviado=1) -->
    <div id="lead-banner" hidden>
      <div role="status" aria-live="polite" class="lead-banner relative overflow-hidden border-b-[3px] border-vividia-gold bg-linear-to-r from-vividia-deep via-vividia-green-dark to-vividia-deep text-white shadow-[0_10px_30px_rgba(31,51,36,.35)]">
        <div class="pointer-events-none absolute -top-16 -left-10 size-48 rounded-full bg-vividia-success/25 blur-3xl"></div>
        <div class="pointer-events-none absolute -right-10 -bottom-16 size-48 rounded-full bg-vividia-coral/20 blur-3xl"></div>

        <div class="relative mx-auto flex max-w-[1180px] flex-col items-center gap-4 px-5 py-5 pr-14 text-center sm:px-6 sm:pr-16 md:flex-row md:gap-6 md:py-4 md:text-left">
          <div class="relative flex size-14 shrink-0 items-center justify-center">
            <span class="lead-check-ring absolute inset-0 rounded-full bg-vividia-success" aria-hidden="true"></span>
            <svg viewBox="0 0 52 52" class="relative size-14 drop-shadow-[0_6px_14px_rgba(62,207,142,.45)]" fill="none" aria-hidden="true">
              <circle class="lead-check-circle" cx="26" cy="26" r="25" fill="#3ecf8e" />
              <path class="lead-check-mark" d="M15 27.5l8 8L38 19" pathLength="1" stroke="#fff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

          <div class="md:flex-1">
            <p class="m-0 font-display text-lg leading-snug font-extrabold sm:text-xl">
              ¡Tu recurso gratuito fue enviado a tu correo!
            </p>
            <p class="m-0 mt-1 text-sm leading-[1.55] text-white/80 sm:text-[15px]">
              Para cualquier duda o consulta puedes escribirnos y te responderemos con gusto.
            </p>
          </div>

          {
            CONTACT_URL && (
              <a
                href={CONTACT_URL}
                target="_blank"
                rel="noopener"
                class="group inline-flex min-h-[46px] shrink-0 items-center justify-center rounded-full bg-white px-6 text-sm font-extrabold text-vividia-deep shadow-[0_8px_20px_rgba(0,0,0,.25)] transition hover:-translate-y-0.5 hover:bg-vividia-gold-light focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-vividia-gold"
              >
                Pincha aquí <span class="ml-2 transition-transform group-hover:-translate-x-1" aria-hidden="true">←</span>
              </a>
            )
          }
        </div>

        <button
          type="button"
          id="lead-banner-close"
          aria-label="Cerrar aviso"
          class="absolute top-2.5 right-3 flex size-10 cursor-pointer items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/25 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-vividia-gold sm:right-4"
        >
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
    </div>

    <!-- ANNOUNCEMENT -->
    <div class="bg-vividia-deep px-4 py-2.5 text-center text-xs font-semibold tracking-wide text-white sm:text-[13px]">
      <span class="text-vividia-gold">REGALO:</span> 5 bonos incluidos con el pack · Garantía de 7 días
    </div>

    <!-- HERO -->
    <header class="relative overflow-hidden bg-vividia-cream">
      <div class="pointer-events-none absolute -top-32 -right-24 size-[420px] rounded-full bg-vividia-coral/15 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-24 size-[420px] rounded-full bg-vividia-green/20 blur-3xl"></div>

      <div class="relative mx-auto max-w-[1180px] px-5 pt-6 pb-16 sm:px-6 lg:pt-8 lg:pb-24">
        <img src="/assets/logo-vividia.png" alt="Vividia Oficial" width="1774" height="887" class="mx-auto mb-8 w-[130px] lg:mx-0 lg:w-[160px]" />

        <div class="grid items-center gap-12 lg:grid-cols-[1.02fr_0.98fr] lg:gap-14">
          <div class="text-center lg:text-left">
            <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-vividia-green-dark/10 bg-white px-4 py-2 text-[11px] font-bold tracking-[0.8px] text-vividia-green-dark shadow-sm">
              <span class="size-2 animate-pulse rounded-full bg-vividia-coral"></span>
              PACK COMPLETO · 200+ RECETAS + 5 BONOS
            </div>

            <h1 class="mb-5 font-display text-[38px] leading-[1.04] font-extrabold tracking-[-1.6px] text-vividia-text sm:text-5xl lg:text-[clamp(44px,4.8vw,64px)] lg:tracking-[-2.6px]">
              <span class="text-vividia-coral">200 recetas para diabéticos</span> para cocinar con <span class="text-vividia-green-dark">variedad</span> y sin dudas
            </h1>

            <p class="mx-auto mb-7 max-w-[560px] text-base leading-[1.65] text-vividia-muted sm:text-lg lg:mx-0">
              Recetario digital con desayunos, almuerzos, cenas, snacks y postres para personas con diabetes. Y hoy te llevas <strong class="text-vividia-text">5 bonos de regalo</strong> sin pagar nada extra.
            </p>

            <ul class="mx-auto mb-8 grid max-w-[480px] gap-3 text-left lg:mx-0">
              {
                ['Más de 200 recetas ordenadas por momento del día', '5 guías y recetarios extra incluidos', 'Acceso inmediato desde móvil, tablet u ordenador'].map((t) => (
                  <li class="flex items-center gap-3 text-[15px] font-semibold">
                    <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-vividia-green text-white">
                      <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.check} /></svg>
                    </span>
                    {t}
                  </li>
                ))
              }
            </ul>

            <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start">
              <a href={CHECKOUT_URL} target="_blank" rel="nofollow noopener" class="cta group relative isolate inline-flex min-h-[62px] w-full items-center justify-center overflow-hidden rounded-2xl bg-linear-to-br from-[#f48a6d] to-[#f26a4b] px-8 text-base font-extrabold text-white shadow-[0_14px_32px_rgba(242,127,98,.4)] transition hover:-translate-y-0.5 sm:w-auto sm:text-[17px]">
                <span class="pointer-events-none absolute inset-y-0 -left-1/3 -z-10 w-1/4 animate-shine bg-white/30"></span>
                Quiero el pack completo
                <span class="ml-2.5 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </div>

            <p class="mt-4 flex items-center justify-center gap-1.5 text-[12px] text-vividia-muted lg:justify-start">
              <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.lock} /></svg>
              Pago seguro procesado por Hotmart
            </p>
          </div>

          <div class="relative mx-auto w-full max-w-[560px]">
            <div class="absolute inset-[6%] rounded-full bg-linear-to-br from-[#dfead9] to-white"></div>
            <div class="relative rotate-[1.5deg] rounded-[28px] bg-white p-3 shadow-[0_40px_80px_rgba(52,71,56,.22)] sm:p-4">
              <img src="/ventas/pack-completo.webp" alt="Pack completo de 200 recetas para diabéticos con 5 bonos de regalo: recetario digital, jugoterapia, panes sin gluten y guías" width="1100" height="1100" fetchpriority="high" class="block h-auto w-full rounded-[20px]" />
            </div>
            <span class="absolute -top-3 -right-1 rotate-6 animate-float rounded-xl bg-vividia-coral px-4 py-2.5 text-[11px] font-extrabold tracking-wider text-white shadow-[0_12px_24px_rgba(242,127,98,.35)] sm:right-2 sm:text-xs" style="--tw-float-rot:6deg">+5 BONOS DE REGALO</span>
            <span class="absolute -bottom-4 left-0 flex -rotate-3 items-center gap-2 rounded-xl bg-vividia-deep px-4 py-2.5 text-[11px] font-bold text-white shadow-xl sm:left-4 sm:text-xs">
              <svg viewBox="0 0 24 24" class="size-4 text-vividia-gold" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.shield} /></svg>
              Garantía de 7 días
            </span>
          </div>
        </div>
      </div>
    </header>

    <main>
      <!-- STRIP -->
      <section class="bg-vividia-deep text-white">
        <div class="mx-auto grid max-w-[1180px] grid-cols-2 gap-y-6 px-5 py-8 sm:px-6 lg:grid-cols-4">
          {
            [
              ['200+', 'recetas'],
              ['5', 'bonos de regalo'],
              ['7 días', 'de garantía'],
              ['100%', 'digital e inmediato'],
            ].map(([n, l]) => (
              <div class="text-center">
                <p class="m-0 font-display text-3xl font-extrabold text-vividia-gold sm:text-4xl">{n}</p>
                <p class="m-0 mt-1 text-xs text-white/70 sm:text-sm">{l}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- PROBLEM -->
      <section class="bg-white py-20 sm:py-24">
        <div class="mx-auto max-w-[1080px] px-5 sm:px-6">
          <div class="mx-auto max-w-[720px] text-center">
            <p class="mb-3 text-[11px] font-extrabold tracking-[1.3px] text-vividia-coral">MÁS IDEAS, MENOS COMPLICACIONES</p>
            <h2 class="mb-4 font-display text-[30px] leading-[1.12] font-extrabold tracking-[-1.2px] sm:text-[44px] sm:tracking-[-1.8px]">¿Te quedas sin ideas cuando llega la hora de cocinar?</h2>
            <p class="m-0 text-base leading-[1.7] text-vividia-muted sm:text-[17px]">Decidir qué preparar cada día cansa. Con un recetario ordenado, la respuesta ya está a un toque.</p>
          </div>

          <div class="mt-12 grid gap-5 md:grid-cols-3">
            {
              problems.map((p) => (
                <article class="rounded-3xl border border-vividia-green-dark/10 bg-vividia-cream p-7 transition hover:-translate-y-1 hover:shadow-[0_18px_40px_rgba(52,71,56,.1)]">
                  <div class="mb-5 flex size-13 items-center justify-center rounded-2xl bg-vividia-coral/15 text-vividia-coral-dark">
                    <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[p.icon as keyof typeof icons]} /></svg>
                  </div>
                  <h3 class="mb-2 font-display text-lg font-extrabold">{p.title}</h3>
                  <p class="m-0 text-sm leading-[1.65] text-vividia-muted">{p.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- PRODUCT -->
      <section class="bg-vividia-green-light py-20 sm:py-24">
        <div class="mx-auto grid max-w-[1080px] items-center gap-12 px-5 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
          <div class="relative mx-auto w-full max-w-[420px]">
            <div class="absolute inset-x-[8%] top-[10%] bottom-0 rounded-[40px] bg-white"></div>
            <div class="absolute -top-2 -left-2 size-16 rounded-full bg-vividia-coral/20"></div>
            <img src="/ventas/libro-200.webp" alt="Portada del recetario 200 recetas para diabéticos" width="720" height="1080" loading="lazy" class="relative mx-auto block h-auto w-[86%] mix-blend-multiply drop-shadow-2xl" />
          </div>

          <div>
            <p class="mb-3 text-[11px] font-extrabold tracking-[1.3px] text-vividia-coral">EL RECETARIO PRINCIPAL</p>
            <h2 class="mb-4 font-display text-[30px] leading-[1.12] font-extrabold tracking-[-1.2px] sm:text-[42px] sm:tracking-[-1.7px]">
