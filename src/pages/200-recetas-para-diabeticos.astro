    <script>
      // Mostramos el banner solo si venimos del formulario y limpiamos la URL para que no reaparezca al recargar o compartir el enlace.
      const banner = document.getElementById('lead-banner');
      const params = new URLSearchParams(location.search);

      if (banner && params.get('enviado') === '1') {
        banner.hidden = false;
        params.delete('enviado');
        const query = params.toString();
        history.replaceState(null, '', location.pathname + (query ? `?${query}` : '') + location.hash);
      }

      document.getElementById('lead-banner-close')?.addEventListener('click', () => {
        if (banner) banner.hidden = true;
      });

      // GA4: clic hacia el checkout de Hotmart (inicio de compra). `beacon` asegura el envío aunque la página se descargue.
      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="https://pay.hotmart.com"]');
        if (!link) return;
        (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag?.('event', 'begin_checkout', {
          currency: 'EUR',
          value: Number(document.body.dataset.price),
          transport_type: 'beacon',
        });
      });
    </script>
